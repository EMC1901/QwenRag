# 模型网关监听地址
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8010

# 允许访问模型网关的 API Key，多个 key 用英文逗号分隔
GATEWAY_API_KEYS=change-me

# 是否允许无 API Key，开发调试时可设 true，服务器对外部署必须设 false
GATEWAY_ALLOW_NO_AUTH=false

# LLM 上游服务
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=qwen
LLM_UPSTREAM_API_KEY=

# Embedding 上游服务
EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_UPSTREAM_API_KEY=

# HTTP 超时
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=180
HTTP_WRITE_TIMEOUT_SECONDS=60
HTTP_POOL_TIMEOUT_SECONDS=5

# 日志
LOG_LEVEL=INFO
LOG_REQUEST_BODY=false

