# -----------------------------------------------------------------------------
# Local environment files, deployment settings, and credentials.
# Keep sanitized examples in Git; never publish machine-specific secrets.
# -----------------------------------------------------------------------------
.env
.env.*
.envrc
!.env.example
!.env.*.example

deployment.json
deployment.*.json
!deployment.example.json
!deployment.*.example.json
secrets.json
secrets.*.json
!secrets.example.json
!secrets.*.example.json
credentials.json
credentials.*.json
!credentials.example.json
!credentials.*.example.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

