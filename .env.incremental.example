# 增量资料入库配置。实际部署时复制为 .env.incremental，并按目标机调整。
# 所有数据目录必须位于 INCREMENTAL_KB_ROOT；OCR 模型目录必须位于项目目录。
INCREMENTAL_KB_ROOT=rag_data
INCREMENTAL_ROOT=rag_data/incremental
INCREMENTAL_INCOMING_DIR=rag_data/incremental/incoming
INCREMENTAL_ARCHIVE_DIR=rag_data/incremental/archive
INCREMENTAL_RESULTS_DIR=rag_data/incremental/results
INCREMENTAL_WORK_DIR=rag_data/incremental/work
INCREMENTAL_LOCKS_DIR=rag_data/incremental/locks
INCREMENTAL_LOG_DIR=rag_data/incremental/logs
KB_GENERATIONS_DIR=rag_data/kb_generations
KB_DELTAS_DIR=rag_data/kb_deltas
KB_MANIFEST_PATH=rag_data/knowledge_manifest.json
# 仅为旧完整代际实现的过渡兼容保留；Base + Delta 发布不再使用它。
KB_CURRENT_POINTER=rag_data/current_generation.txt

LOCAL_RAG_HEALTH_URL=http://127.0.0.1:18080/health
LOCAL_RAG_HOST=127.0.0.1
LOCAL_RAG_PORT=18080

OCR_DEVICE=cpu
OCR_CPU_THREADS=4
OCR_RENDER_DPI=200
OCR_RETRY_DPI=300
OCR_MAX_CONCURRENT_PAGES=1
OCR_MODEL_DIR=models/ocr
OCR_TEXT_DETECTION_MODEL=PP-OCRv5_mobile_det
OCR_TEXT_RECOGNITION_MODEL=PP-OCRv5_mobile_rec

OCR_LOW_LINE_CONFIDENCE=0.80
OCR_PAGE_WARNING_CONFIDENCE=0.85
OCR_PAGE_WARNING_LOW_LINE_RATIO=0.20
OCR_SEVERE_PAGE_CONFIDENCE=0.60
OCR_SEVERE_PAGE_MIN_VALID_CHARS=20
OCR_SEVERE_PAGE_GARBLED_RATIO=0.10
OCR_DOCUMENT_SEVERE_PAGE_RATIO=0.20
OCR_DOCUMENT_MAX_CONSECUTIVE_SEVERE_PAGES=5
OCR_DOCUMENT_MAX_SEVERE_PAGES=10

FILE_STABILITY_PROBE_COUNT=3
FILE_STABILITY_PROBE_INTERVAL_SECONDS=2
EMBEDDING_MAX_RETRIES=3
# Point directly to the deployed OpenAI-compatible model gateway. Do not start
# the local RAG application while incremental ingestion is running.
EMBEDDING_BASE_URL=http://172.17.10.20:8010/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=128
FAILED_WORK_RETENTION_DAYS=7
TECH_LOG_RETENTION_DAYS=180

# 阶段 1 仅确认磁盘可用；阶段 4 会按正式资产和候选资产计算完整空间需求。
INCREMENTAL_MIN_FREE_BYTES=1
