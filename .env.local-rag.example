# 本地 HTTP 服务：阶段 1、2 只允许回环地址，避免意外暴露给局域网。
LOCAL_RAG_HOST=127.0.0.1
LOCAL_RAG_PORT=18080
LOCAL_RAG_MODEL=local-rag

# Chatbox 中填写同一个 API Key。开发阶段可使用占位值 none。
LOCAL_RAG_API_KEYS=none
LOCAL_RAG_ALLOW_NO_AUTH=false

# stub：后续阶段先使用固定回答验证接口；gateway：调用子任务3模型网关。
LOCAL_RAG_ANSWER_MODE=stub

# 子任务5：true 时仅在 gateway 模式下先判断问题是否需要本地知识库。
# 默认 false，保持子任务4的接口联调和普通网关回答行为。
ENABLE_RAG_ROUTER=false

# 判断器只返回短 JSON；单位为 token，允许范围为 32 到 256。
RAG_ROUTER_MAX_TOKENS=128

# 仅在 gateway 模式下必填。开发验证地址不可写死到 Python 源码。
MODEL_GATEWAY_BASE_URL=http://172.17.10.20:8010/v1
MODEL_GATEWAY_API_KEY=change-me
UPSTREAM_LLM_MODEL=qwen

# 子任务6：默认关闭。仅当 gateway、RAG 路由和本开关都启用时执行本地检索。
ENABLE_LOCAL_RETRIEVAL=false

# 子任务7：只有 gateway、RAG 路由、本地检索和本开关都启用时才生成 RAG 答案。
# 默认关闭，保持子任务6“检索成功后返回阶段性 503”的行为。
ENABLE_RAG_ANSWER_GENERATION=false

# 交付知识库根目录；相对路径以项目根目录解析。
RAG_KNOWLEDGE_BASE_DIR=rag_data

# 必须与离线索引构建时使用的 Embedding 模型和维度完全一致。
UPSTREAM_EMBEDDING_MODEL=qwen3-embedding-0.6b
RAG_EMBEDDING_DIM=1024

# 向量、关键词候选数，最终返回数，以及单文档最多保留的 chunk 数。
RAG_VECTOR_TOP_K=40
RAG_FTS_TOP_K=40
RAG_FINAL_TOP_K=8
RAG_MAX_CHUNKS_PER_DOC=3

# FTS5 与向量结果使用加权 RRF 融合；FTS 失败时可回退为纯向量检索。
RAG_ENABLE_FTS=true
RAG_ALLOW_FTS_FALLBACK=true
RAG_RRF_K=60
RAG_VECTOR_WEIGHT=0.6
RAG_FTS_WEIGHT=0.4

# 正式交付必须为 false；只允许开发抽样索引显式开启。
RAG_ALLOW_PARTIAL_INDEX=false

# 子任务7：当前开发 LLM 的 llama-server 使用 -c 8192；客户环境必须按实际模型修改。
# 输入、输出和安全余量三者之和不得超过上下文窗口。
RAG_LLM_CONTEXT_WINDOW_TOKENS=8192
RAG_MAX_INPUT_TOKENS=6144
RAG_MAX_OUTPUT_TOKENS=1024
RAG_TOKEN_SAFETY_MARGIN=1024

# 输入预算内部的证据、对话历史和单个 chunk 上限。计数是保守估算值，不是上游精确 usage。
RAG_CONTEXT_BUDGET_TOKENS=4096
RAG_HISTORY_BUDGET_TOKENS=768
RAG_MAX_CHUNK_TOKENS=1024
RAG_MIN_CHUNK_TOKENS=64

# RAG 回答使用低随机性；客户端请求不能绕过该服务端上限。
RAG_GENERATION_TEMPERATURE=0.2

# 调用模型网关的 HTTP 超时（单位：秒）。
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=180
HTTP_WRITE_TIMEOUT_SECONDS=60
HTTP_POOL_TIMEOUT_SECONDS=5

# 默认不记录完整 messages 或密钥。
LOG_LEVEL=INFO
LOG_REQUEST_BODY=false
